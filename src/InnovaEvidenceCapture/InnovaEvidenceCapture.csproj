<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>InnovaEvidenceCapture</AssemblyName>
    <RootNamespace>InnovaEvidenceCapture</RootNamespace>
    <Product>Innova Evidence Capture</Product>
    <Company>Innova Monitoring</Company>
    <Version>0.4.1</Version>
    <FileVersion>0.4.1.0</FileVersion>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <!-- Permite compilar (no ejecutar) desde macOS/Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!--
      WinForms se usa SOLO para el icono de la bandeja, pero sus usings
      implicitos meten System.Windows.Forms y System.Drawing en todos los
      archivos y chocan con WPF: Color, Orientation, Clipboard, MessageBox,
      HorizontalAlignment y MouseEventArgs existen en ambos mundos.
      Se quitan del global y cada archivo importa lo que de verdad necesita.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embebido para que el icono de la bandeja no dependa de archivos sueltos -->
    <EmbeddedResource Include="assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
